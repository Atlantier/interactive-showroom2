{
  "name": "interactive-showroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "个人数字展厅 · Immersive interactive showroom built with Vite + React 19 + TypeScript + Tailwind CSS + React Three Fiber",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=13",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:selftest": "node scripts/lib/verify.selftest.mjs",
    "verify:budget": "node scripts/verify-budget.mjs",
    "verify:scroll": "node scripts/verify-scroll.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.13.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
